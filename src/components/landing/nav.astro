---
import { site } from "@/config/site"
---

<header
  class="sticky top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur-xl"
>
  <nav class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6">
    <a
      href="/"
      class="flex items-center gap-2.5 font-mono text-sm font-medium tracking-tight"
    >
      <img
        src="/icon-128.png"
        alt={`${site.brand} logo`}
        width="28"
        height="28"
        class="size-7 rounded-md"
      />
      <span>{site.brand}</span>
    </a>

    <ul class="hidden flex-1 items-center justify-center gap-7 text-sm md:flex">
      <li>
        <a
          href="#whats-inside"
          class="lk-link text-muted-foreground transition-colors hover:text-foreground"
          data-umami-event="nav-click"
          data-umami-event-target="whats-inside"
          data-umami-event-location="nav">What's inside</a
        >
      </li>
      <li>
        <a
          href="#features"
          class="lk-link text-muted-foreground transition-colors hover:text-foreground"
          data-umami-event="nav-click"
          data-umami-event-target="features"
          data-umami-event-location="nav">Features</a
        >
      </li>
      <li>
        <a
          href="#pricing"
          class="lk-link text-muted-foreground transition-colors hover:text-foreground"
          data-umami-event="nav-click"
          data-umami-event-target="pricing"
          data-umami-event-location="nav">Pricing</a
        >
      </li>
      <li>
        <a
          href="#faq"
          class="lk-link text-muted-foreground transition-colors hover:text-foreground"
          data-umami-event="nav-click"
          data-umami-event-target="faq"
          data-umami-event-location="nav">FAQ</a
        >
      </li>
    </ul>

    <div class="ml-auto flex items-center gap-3 md:ml-0">
      <a
        href="#pricing"
        class="inline-flex h-9 items-center gap-2 rounded-md bg-foreground px-4 text-sm font-medium text-background transition-colors hover:bg-foreground/85"
        data-umami-event="cta-click"
        data-umami-event-location="nav"
      >
        <span class="hidden sm:inline">Buy</span>
        <span class="font-mono">{site.pricing.tiers[0].priceLabel}</span>
      </a>
    </div>
  </nav>
</header>
