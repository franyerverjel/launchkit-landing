---
import { faqs as items } from "@/config/faq"
import { site } from "@/config/site"
---

<section id="faq" class="border-b border-border/60">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <span class="lk-section-num">10 / FAQ</span>
        <h2 class="lk-balance mt-4 lk-display text-3xl md:text-4xl">
          The honest answers.
        </h2>
        <p class="mt-6 leading-relaxed text-muted-foreground">
          Anything else?
          <a
            href={`mailto:${site.social.email}`}
            class="lk-link text-foreground"
            data-umami-event="email-click"
            data-umami-event-location="faq">Email us directly</a
          > — we read every message.
        </p>

        <div
          class="mt-10 rounded-2xl border border-border/60 bg-secondary/40 p-5"
        >
          <p class="lk-mono-label">From the maker</p>
          <p class="mt-3 text-sm leading-relaxed text-foreground/85">
            I’m Franyer. After 13+ years of building web products I kept
            rebuilding the same auth, tenants and billing plumbing for every
            client — LaunchKit is that plumbing, done once, properly. Not sure
            it fits your project? Email me before you buy. I’d rather answer a
            question than lose you to a refund.
          </p>
          <p class="mt-3 font-mono text-xs text-muted-foreground">
            — Franyer Verjel ·
            <a
              href="https://franyer.dev?utm_source=launchasaas&utm_medium=faq&utm_campaign=founder"
              target="_blank"
              rel="noopener noreferrer"
              class="lk-link text-foreground"
              data-umami-event="outbound-click"
              data-umami-event-target="franyer.dev"
              data-umami-event-location="faq">franyer.dev</a
            >
          </p>
        </div>
      </div>

      <div class="lg:col-span-8">
        <ul class="flex flex-col">
          {
            items.map((item, i) => (
              <li class="border-t border-border/60 first:border-t-0">
                <details class="group/faq py-1" data-faq-question={item.q}>
                  <summary class="flex cursor-pointer list-none items-baseline gap-5 py-5 select-none">
                    <span class="shrink-0 lk-section-num transition-colors group-open/faq:text-coral">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span class="flex-1 lk-display text-xl leading-tight md:text-2xl">
                      {item.q}
                    </span>
                    <span
                      aria-hidden="true"
                      class="shrink-0 text-muted-foreground transition-transform duration-200 group-open/faq:rotate-45 group-open/faq:text-coral"
                    >
                      <svg
                        viewBox="0 0 16 16"
                        class="size-4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="M8 3v10M3 8h10" stroke-linecap="round" />
                      </svg>
                    </span>
                  </summary>
                  <div class="pr-2 pb-6 pl-12 text-base leading-relaxed text-muted-foreground">
                    {item.a}
                  </div>
                </details>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Remove default details marker — already replaced with our + → × icon */
  details > summary::-webkit-details-marker {
    display: none;
  }
  details > summary {
    list-style: none;
  }
</style>
