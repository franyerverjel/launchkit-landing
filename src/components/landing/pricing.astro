---
import { site } from "@/config/site"
import { cn } from "@/lib/utils"
const { tiers, discount } = site.pricing
---

<section id="pricing" class="border-b border-border/60 bg-secondary/30">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-20 md:py-28">
    <div class="max-w-3xl mb-12">
      <span class="lk-section-num">08 / Pricing</span>
      <div class="mt-4 flex flex-wrap items-baseline gap-x-5 gap-y-2">
        <h2 class="lk-display lk-balance text-4xl md:text-5xl lg:text-6xl">
          One payment. <em class="text-muted-foreground">Lifetime</em> license.
        </h2>
        {discount.enabled && (
          <span class="inline-flex items-center gap-2 rounded-full bg-coral/15 px-3 py-1 font-mono text-[11px] font-semibold uppercase tracking-widest text-coral-deep">
            <span class="size-1.5 rounded-full bg-coral animate-pulse" />
            {discount.label}
          </span>
        )}
      </div>
      <p class="mt-6 text-lg text-muted-foreground leading-relaxed">
        No subscriptions. No per-seat creep. Pay once, own the source,
        ship as many SaaS projects as you can dream up.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 max-w-4xl">
      {
        tiers.map((tier) => (
          <article
            class={cn(
              "relative flex flex-col gap-7 rounded-2xl border p-7 md:p-8",
              tier.featured
                ? "border-foreground bg-foreground text-background shadow-2xl shadow-foreground/20 lg:scale-[1.03]"
                : "border-border bg-background"
            )}
          >
            {tier.featured && tier.badge && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-coral px-3 py-1 font-mono text-[10px] uppercase tracking-widest text-coral-foreground shadow-sm">
                  <svg viewBox="0 0 16 16" class="size-3" fill="currentColor" aria-hidden="true">
                    <path d="M8 1l1.8 4.2L14 7l-4.2 1.8L8 13l-1.8-4.2L2 7l4.2-1.8L8 1z" />
                  </svg>
                  {tier.badge}
                </span>
              </div>
            )}

            <header class="flex flex-col gap-3">
              <span class={cn("lk-mono-label", tier.featured && "text-background/55")}>
                {tier.name}
              </span>
              <div class="flex items-baseline gap-3">
                <span class="lk-display text-6xl">{tier.priceLabel}</span>
                {tier.originalPriceLabel && (
                  <span class={cn(
                    "font-mono text-xl line-through",
                    tier.featured ? "text-background/40" : "text-muted-foreground/70"
                  )}>
                    {tier.originalPriceLabel}
                  </span>
                )}
              </div>
              <p class={cn("text-sm", tier.featured ? "text-background/70" : "text-muted-foreground")}>
                {tier.cadence} · {tier.seat}
              </p>
            </header>

            <hr class={cn("lk-rule", tier.featured && "border-background/15")} />

            <ul class="flex flex-col gap-3 text-sm">
              {tier.bullets.map((bullet) => (
                <li class="flex items-start gap-3">
                  <span
                    class={cn(
                      "mt-0.5 inline-grid size-4 shrink-0 place-items-center rounded-full",
                      tier.featured
                        ? "bg-coral text-coral-foreground"
                        : "bg-foreground text-background"
                    )}
                  >
                    <svg viewBox="0 0 16 16" class="size-2.5" fill="none" stroke="currentColor" stroke-width="3">
                      <path d="M3 8l3 3 7-7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <span class="leading-relaxed">{bullet}</span>
                </li>
              ))}
            </ul>

            <a
              href={tier.href}
              class={cn(
                "lk-pill mt-auto inline-flex h-12 items-center justify-center gap-2 text-sm font-medium transition-all shadow-sm",
                tier.featured
                  ? "bg-coral text-coral-foreground hover:bg-coral-deep shadow-lg shadow-coral/30 hover:shadow-xl"
                  : "bg-foreground text-background hover:bg-foreground/85"
              )}
            >
              {tier.cta}
              <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>

            <p class={cn("text-xs text-center", tier.featured ? "text-background/50" : "text-muted-foreground")}>
              Stripe-secured · Code in your inbox in 5 min
            </p>
          </article>
        ))
      }
    </div>

    {/* Reassurance row */}
    <div class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-muted-foreground">
      <div class="flex items-center gap-2">
        <svg viewBox="0 0 16 16" class="size-4 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M8 1L2 4v4c0 3.5 2.5 6 6 7 3.5-1 6-3.5 6-7V4L8 1z" stroke-linejoin="round" />
        </svg>
        14-day no-questions refund
      </div>
      <div class="flex items-center gap-2">
        <svg viewBox="0 0 16 16" class="size-4 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="2" y="6" width="12" height="8" rx="1" />
          <path d="M5 6V4a3 3 0 0 1 6 0v2" />
        </svg>
        Stripe-secured payment
      </div>
      <div class="flex items-center gap-2">
        <svg viewBox="0 0 16 16" class="size-4 text-foreground" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 4l5-2 5 2v5c0 3-2 5-5 6-3-1-5-3-5-6V4z" stroke-linejoin="round" />
          <path d="M6 8l1.5 1.5L10 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Instant download · code in your inbox
      </div>
    </div>
  </div>
</section>
