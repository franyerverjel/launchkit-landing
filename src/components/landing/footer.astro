---
import { site } from "@/config/site"
const year = new Date().getFullYear()
---

<footer class="border-t border-border/60 bg-background">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <a href="/" class="flex items-center gap-2 font-mono text-sm font-medium tracking-tight">
          <span aria-hidden="true" class="inline-grid size-7 place-items-center rounded-sm bg-foreground text-background">
            <span class="font-display text-lg leading-none">L</span>
          </span>
          <span>{site.brand}</span>
        </a>
        <p class="mt-4 max-w-xs text-sm text-muted-foreground leading-relaxed">
          Production-grade SaaS boilerplate. Multi-tenant, secure,
          internationalized. Buy once, ship forever.
        </p>
      </div>

      <nav class="md:col-span-7 grid grid-cols-3 gap-8 text-sm">
        <div class="flex flex-col gap-3">
          <h3 class="lk-mono-label">Product</h3>
          <ul class="flex flex-col gap-2">
            <li><a href="#whats-inside" class="lk-link text-muted-foreground hover:text-foreground transition-colors">What's inside</a></li>
            <li><a href="#features" class="lk-link text-muted-foreground hover:text-foreground transition-colors">Features</a></li>
            <li><a href="#pricing" class="lk-link text-muted-foreground hover:text-foreground transition-colors">Pricing</a></li>
          </ul>
        </div>
        <div class="flex flex-col gap-3">
          <h3 class="lk-mono-label">Resources</h3>
          <ul class="flex flex-col gap-2">
            <li><a href="#faq" class="lk-link text-muted-foreground hover:text-foreground transition-colors">FAQ</a></li>
            <li><a href="/changelog" class="lk-link text-muted-foreground hover:text-foreground transition-colors">Changelog</a></li>
            <li><a href={`mailto:${site.social.email}`} class="lk-link text-muted-foreground hover:text-foreground transition-colors">Email us</a></li>
          </ul>
        </div>
        <div class="flex flex-col gap-3">
          <h3 class="lk-mono-label">Legal</h3>
          <ul class="flex flex-col gap-2">
            <li><a href="/license" class="lk-link text-muted-foreground hover:text-foreground transition-colors">License</a></li>
            <li><a href="/privacy" class="lk-link text-muted-foreground hover:text-foreground transition-colors">Privacy</a></li>
            <li><a href="/terms" class="lk-link text-muted-foreground hover:text-foreground transition-colors">Terms</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="mt-12 flex flex-col-reverse items-start justify-between gap-3 border-t border-border/60 pt-6 text-xs text-muted-foreground md:flex-row md:items-center">
      <p class="font-mono">© {year} {site.brand}. Crafted with too much coffee.</p>
      <p class="font-mono">v1.0 · last shipped {new Date().toISOString().slice(0, 10)}</p>
    </div>
  </div>
</footer>
