---
const pains = [
  {
    label: "W1",
    text: "Auth · JWT refresh · Password reset · Email verify · 2FA · Google OAuth",
  },
  {
    label: "W2",
    text: "Tenants · Roles · Member invites · Permission system with wildcards",
  },
  {
    label: "W3",
    text: "Stripe · Plans · Addons · Webhooks · Idempotency · Past-due grace",
  },
  {
    label: "W4",
    text: "i18n · Audit logs · Rate limits · Error pages · Tests · CI · …",
  },
]
---

<section class="border-b border-border/60">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <span class="lk-section-num">02 / Problem</span>
        <h2 class="mt-3 lk-display text-3xl md:text-4xl lg:text-5xl">
          You've built this <em class="text-muted-foreground">exact thing</em> four
          times already.
        </h2>
        <p
          class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground"
        >
          Three weeks of plumbing before a single feature line lands. Skip it.
        </p>
      </div>

      <ol class="grid gap-2 self-end lg:col-span-7">
        {
          pains.map((pain) => (
            <li class="grid grid-cols-[3rem_1fr] items-baseline gap-5 border-t border-border py-3.5 first:border-t-0 first:pt-0">
              <span class="shrink-0 font-mono text-xs tracking-[0.2em] text-coral-deep uppercase">
                {pain.label}
              </span>
              <p class="font-mono text-[13px] leading-relaxed text-foreground/85 md:text-sm">
                {pain.text}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
