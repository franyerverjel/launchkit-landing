---
/**
 * Layout used by /terms, /privacy, /license and /changelog. Wraps the
 * markdown body in the same nav + footer as the marketing landing so the
 * brand reads as a single product. The body styles are scoped to
 * `.lk-prose` and use the same warm cream + ink + coral palette as the
 * rest of the site.
 *
 * The four pages that consume this layout are intentionally plain
 * markdown — buyers edit the .md/.astro files directly. There is no
 * CMS or content collection; the source is the file.
 */
import Main from "@/layouts/main.astro"
import Nav from "@/components/landing/nav.astro"
import Footer from "@/components/landing/footer.astro"

interface Props {
  /** Page title — used in <title>, og:title and the visible h1. */
  title: string
  /** Meta description — also used as og:description / twitter:description. */
  description?: string
  /** Optional eyebrow shown above the heading, e.g. "Last updated · 2026-05-01". */
  eyebrow?: string
  /**
   * Override the visible h1 if you don't want the same string as the
   * <title> tag. Useful when SEO title is verbose but the on-page
   * heading should be short.
   */
  heading?: string
  /** Markdown frontmatter pages set this so the layout doesn't render its
   *  own <h1> twice — the markdown's first # already does. Default: true. */
  showHeading?: boolean
}

const {
  title,
  description,
  eyebrow,
  heading,
  showHeading = true
} = Astro.props as Props
---

<Main title={title} description={description}>
  <Nav />
  <main class="relative">
    {/* Soft halo + halftone — same atmosphere as the hero so legal pages
        don't feel detached from the rest of the brand. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[36rem] overflow-hidden"
    >
      <div class="lk-halftone absolute inset-0 opacity-[0.04]"></div>
      <div
        class="absolute -top-40 left-1/2 size-[36rem] -translate-x-1/2 rounded-full bg-coral/20 blur-[140px]"
      ></div>
    </div>

    <article class="mx-auto max-w-3xl px-4 sm:px-6 py-16 md:py-24">
      <header class="mb-12 space-y-5">
        {eyebrow && (
          <p class="lk-mono-label">{eyebrow}</p>
        )}
        {showHeading && (
          <h1 class="lk-display lk-balance text-4xl md:text-5xl">{heading ?? title}</h1>
        )}
        {description && (
          <p class="max-w-2xl text-base md:text-lg text-muted-foreground leading-relaxed">
            {description}
          </p>
        )}
      </header>

      <hr class="lk-rule mb-12" />

      <div class="lk-prose">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Main>

<style is:global>
  /* Editorial prose styles — narrow column, generous leading, mono labels
     for code blocks, coral accents for inline code. Tuned to feel like
     the rest of the site (Geist Variable + Geist Mono) rather than a
     generic Markdown drop. */
  .lk-prose {
    color: var(--foreground);
    font-size: 1rem;
    line-height: 1.7;
  }
  .lk-prose > * + * {
    margin-top: 1.25rem;
  }
  .lk-prose h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-top: 0;
    text-wrap: balance;
  }
  .lk-prose h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-top: 3rem;
    text-wrap: balance;
  }
  .lk-prose h2 + p,
  .lk-prose h2 + ul,
  .lk-prose h2 + ol,
  .lk-prose h3 + p,
  .lk-prose h3 + ul {
    margin-top: 0.75rem;
  }
  .lk-prose h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin-top: 2rem;
    color: var(--foreground);
  }
  .lk-prose h4 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--coral);
    margin-top: 2rem;
  }
  .lk-prose p {
    color: color-mix(in oklch, var(--foreground) 88%, transparent);
  }
  .lk-prose strong {
    color: var(--foreground);
    font-weight: 600;
  }
  .lk-prose a {
    color: var(--coral-deep);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }
  .lk-prose a:hover {
    color: var(--foreground);
  }
  .lk-prose ul,
  .lk-prose ol {
    padding-left: 1.4rem;
    color: color-mix(in oklch, var(--foreground) 88%, transparent);
  }
  .lk-prose ul {
    list-style: disc;
  }
  .lk-prose ol {
    list-style: decimal;
  }
  .lk-prose li {
    margin-top: 0.4rem;
    padding-left: 0.25rem;
  }
  .lk-prose li::marker {
    color: var(--coral);
  }
  .lk-prose code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--coral-deep);
    background: color-mix(in oklch, var(--coral-soft) 60%, transparent);
    border: 1px solid color-mix(in oklch, var(--coral) 18%, transparent);
    border-radius: 0.35rem;
    padding: 0.05rem 0.35rem;
  }
  .lk-prose pre {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    background: var(--foreground);
    color: var(--background);
    padding: 1.25rem 1.5rem;
    border-radius: 0.85rem;
    overflow-x: auto;
    border: 1px solid var(--foreground);
    margin: 1.75rem 0;
  }
  .lk-prose pre code {
    font-size: inherit;
    color: inherit;
    background: transparent;
    border: 0;
    padding: 0;
    border-radius: 0;
  }
  .lk-prose blockquote {
    border-left: 2px solid var(--coral);
    padding: 0.25rem 1rem;
    color: var(--muted-foreground);
    font-style: italic;
  }
  .lk-prose hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }
  .lk-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.95rem;
  }
  .lk-prose th,
  .lk-prose td {
    border-bottom: 1px solid var(--border);
    padding: 0.6rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .lk-prose th {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted-foreground);
  }
</style>
