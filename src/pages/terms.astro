---
/**
 * Terms of Service for the marketing landing.
 *
 * IMPORTANT — buyers customize this file directly. Edit the copy below;
 * each section is a normal HTML/Astro block. The visual scaffolding
 * (typography, spacing, colors) lives in `src/layouts/legal.astro`.
 *
 * Update `lastUpdated` whenever you change the copy. Replace the
 * `{contactEmail}` and `{jurisdiction}` constants with your real
 * values before launch.
 */
import Legal from "@/layouts/legal.astro"
import { site } from "@/config/site"

const lastUpdated = "2026-05-01"
const contactEmail = site.social.email
const jurisdiction = "the jurisdiction where the company is registered"
---

<Legal
